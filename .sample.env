# ─── Infrastructure ────────────────────────────────────────────────
# All values below are the built-in defaults — copying this file to .env
# and changing values as needed is enough for local development.

# RabbitMQ connection. Set RABBITMQ_URL; RABBITMQ_URI is a deprecated alias
# still accepted as a fallback (all apps resolve it through libs/rmq).
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# MongoDB (process)
MONGO_URI=mongodb://localhost:27017/event_tracker

# Redis (process) — rules cache + ranking cache
REDIS_HOST=localhost
REDIS_PORT=6379

# ─── RabbitMQ tuning ──────────────────────────────────────────────
# Queue names — must be consistent across all apps that touch them:
#   RMQ_INGESTION_QUEUE    : agent publishes → process (ingest) consumes
#   RMQ_EVALUATION_QUEUE   : process (ingest) publishes → process (evaluate) consumes
RMQ_INGESTION_QUEUE=events_queue
RMQ_EVALUATION_QUEUE=events_evaluation_queue

# Max unacked messages per consumer; caps memory when a consumer falls behind
RMQ_PREFETCH_COUNT=500

# ─── Redis cache TTLs (seconds) ───────────────────────────────────
# Rules cache: active rule set (invalidated immediately on rule changes)
REDIS_RULES_TTL_SEC=3600
# Ranking cache: per-rule agent ranking served from the report API
REDIS_RANKING_TTL_SEC=3600

# ─── Process service ──────────────────────────────────────────────
# HTTP port for the REST API (ingest + both roles)
PORT=3000

# Deployment role: both (default, single process) | ingest | evaluate
#   both     — events_queue + events_evaluation_queue consumers + HTTP
#   ingest   — events_queue consumer + HTTP API
#   evaluate — events_evaluation_queue consumer only, no HTTP port
PROCESS_ROLE=both

# ─── Reports ──────────────────────────────────────────────────────
# Max timestamps-report window in hours; wider spans are rejected with 400
REPORT_MAX_WINDOW_HOURS=24

# ─── Agent ────────────────────────────────────────────────────────
# Identifier included in every event; run multiple agents with distinct ids
AGENT_ID=agent-default-1

# Milliseconds between events (200 = ~5 events/sec; 1000 = 1/sec)
AGENT_EMIT_INTERVAL_MS=200
